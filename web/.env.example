# Copia este archivo a .env.local y pon tu key real.
MASSIVE_API_KEY=tu_api_key_de_massive
MASSIVE_MAX_PAGES=40

# Cookie de sesión de app.marketsnack.com (para el sub-agente Time & Sales).
# DevTools → Network → request a /api/flow_feed → copia el header "Cookie" completo.
MARKETSNACK_COOKIE=

# Finnhub — precio en tiempo real del subyacente (finnhub.io/dashboard).
# Rellena el precio que el stock snapshot de Massive no da (403).
FINNHUB_API_KEY=

# Tradier — respaldo del GEX (cadena con griegos e IV reales, API key estable).
# Tradier → Settings → API Access → copia el Access Token.
# Si usas el token de SANDBOX (datos diferidos gratis), pon TRADIER_SANDBOX=true.
TRADIER_API_KEY=
TRADIER_SANDBOX=false
